# Email Firebase Authentication được phép xoá đơn, phân cách bằng dấu phẩy.
# Mặc định khớp tài khoản trên màn hình đăng nhập hiện tại.
ROOM_ADMIN_EMAILS=admin@gmail.com

# Nếu dùng dự án Firebase khác, khai báo cùng cấu hình NEXT_PUBLIC_FIREBASE_*
# như lib/firebase.ts; server xác thực token bằng NEXT_PUBLIC_FIREBASE_API_KEY.
